+void CShotgun::ActionWorked( void )
+{
+	// The player worked the action.
+	//
+	// No animation is sent: the engine poses the action bone from the hand
+	// directly, so the motion the player made IS the motion the weapon makes.
+	//
+	// Nothing is ejected either. Working a loaded action really would throw
+	// the chambered round away, but a stroke short enough to be comfortable
+	// is also short enough to happen by accident while carrying the gun, and
+	// losing ammunition you never chose to lose is not a mechanic anyone
+	// wants to live with.
+	m_flPumpTime = 0;
+}
