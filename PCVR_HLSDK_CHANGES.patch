+void CBasePlayerWeapon::DropMagazine( void )
+{
+	if( m_iClip <= 0 || !m_pPlayer )
+		return;
+
+	// A ROUND IN THE CHAMBER DOES NOT LEAVE WITH THE MAGAZINE.
+	//
+	// Dropping a mag with one up the spout leaves exactly that: one shot. The
+	// rest go on the floor with the magazine, which is what makes reloading
+	// early cost something.
+	//
+	// Firing that last round then empties the weapon, which locks the slide
+	// back and means the next magazine has to be racked before it will fire -
+	// and that already follows from the clip reaching zero.
+	m_iClip = ( m_iClip > 0 ) ? 1 : 0;
+	m_pPlayer->TabulateAmmo();
+
+}
