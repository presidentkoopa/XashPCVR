+// Is this player loading their weapons by hand, one round at a time?
+//
+// Set by the VR engine in the player's userinfo, so it is PER PLAYER: a
+// headset player and a flatscreen player on the same server get their own
+// answers, and a dedicated server with nobody in VR never sees it set.
+//
+// Absent - which is every non-VR client and every ordinary engine - reads as
+// FALSE, so weapons behave exactly as they always have unless somebody is
+// actually standing there feeding them.
+BOOL UTIL_PlayerHandLoads( CBaseEntity *pPlayer );
