+BOOL UTIL_PlayerHandLoads( CBaseEntity *pPlayer )
+{
+	const char *pszValue;
+
+	if( !pPlayer || !pPlayer->edict() )
+		return FALSE;
+
+	pszValue = g_engfuncs.pfnInfoKeyValue(
+		g_engfuncs.pfnGetInfoKeyBuffer( pPlayer->edict() ), "vr_handload" );
+
+	return ( pszValue && pszValue[0] == '1' ) ? TRUE : FALSE;
+}
